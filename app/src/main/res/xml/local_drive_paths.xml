<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Files can only be opened or shared from folders named here: Tetra, and Drive for a phone whose rename refused (TetraFolder). -->
    <external-path name="tetra" path="Tetra/" />
    <external-path name="drive" path="Drive/" />
    <files-path name="hidden_media" path="hidden_media/" />
    <!-- Writer's log, sent from File › Send log. -->
    <files-path name="logs" path="logs/" />
    <external-files-path name="logs_shared" path="logs/" />
    <!-- the tetra-calendar skill, shared from Calendar › Share with Claude -->
    <cache-path name="share" path="share/" />
</paths>
